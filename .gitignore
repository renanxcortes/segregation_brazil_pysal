# --- Large source data: NOT pushable to GitHub (>100 MB per-file limit) ----
# These are the IBGE inputs the pipeline reads. They are external by design;
# see MANIFEST.md for where to download them. Nothing here should be committed.

# 2022 Census tract shapefiles (used by the pipeline) and older per-state copies
shapefiles_2022/
/[A-Z][A-Z]_setores_CD2022/
rs_setores_censitarios/
rs_setores_censitarios.zip

# 2022 Census "cor ou raça" tract aggregates (~192 MB CSV)
Agregados_por_setores_cor_ou_raca_BR_csv/
Agregados_por_bairros_demografia_BR.zip

# 2019 Higher-Education microdata (multi-GB CSVs)
microdados_censo_superior_2019/
microdados_censo_superior_2019.zip

